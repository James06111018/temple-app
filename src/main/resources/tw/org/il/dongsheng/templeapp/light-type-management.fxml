<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="520" prefHeight="420"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tw.org.il.dongsheng.templeapp.LightTypeManagementController"
            stylesheets="@style.css"
            style="-fx-background-color: #f0f0f0;">
    <center>
        <VBox spacing="10" style="-fx-padding: 12;">
            <TableView fx:id="lightTypeTable" prefHeight="250" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="codeColumn" text="代碼" prefWidth="80" />
                    <TableColumn fx:id="nameColumn" text="燈種名稱" prefWidth="220" />
                    <TableColumn fx:id="enabledColumn" text="顯示" prefWidth="70" />
                    <TableColumn fx:id="sortColumn" text="排序" prefWidth="70" />
                </columns>
            </TableView>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="70" />
                    <ColumnConstraints minWidth="130" />
                    <ColumnConstraints halignment="RIGHT" minWidth="70" />
                    <ColumnConstraints minWidth="100" />
                </columnConstraints>

                <Label text="代碼" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="codeField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="排序" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="sortField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="燈種名稱" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />

                <Label text="顯示" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <CheckBox fx:id="enabledBox" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 0 12 12 12;">
            <Button text="新增" styleClass="btn-purple" prefWidth="80" onAction="#onNew" />
            <Button text="儲存" styleClass="btn-save-active" prefWidth="80" onAction="#onSave" />
        </HBox>
    </bottom>
</BorderPane>
