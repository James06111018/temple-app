<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1220" prefHeight="670"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tw.org.il.dongsheng.templeapp.HouseholdLightController"
            stylesheets="@style.css"
            style="-fx-background-color: #f0f0f0;">
    <center>
        <VBox spacing="12" style="-fx-padding: 16 12 12 12;">
            <TableView fx:id="householdTable" prefHeight="505" VBox.vgrow="ALWAYS" />

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Button text="|◀" />
                <Button text="◀" />
                <TextField text="1" alignment="CENTER_RIGHT" prefWidth="62" />
                <Label text="總筆數： 8" />
                <Button text="▶" />
                <Button text="▶|" />
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="收據代表人" />
                <ComboBox fx:id="collectorBox" prefWidth="180" />
                <Label text="油香" />
                <TextField prefWidth="100" />
                <Button text="確定" styleClass="btn-orange" onAction="#onPlaceholderAction" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="燈種管理" styleClass="btn-purple" onAction="#onOpenLightTypeManagement" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="補登日期" />
                <TextField prefWidth="90" />
                <Label text="補登號碼" />
                <TextField prefWidth="110" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
