<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tw.org.il.dongsheng.templeapp.SyncSettingsController"
            prefWidth="700" prefHeight="560"
            stylesheets="@style.css"
            style="-fx-background-color: #f5f0e8;">
    <center>
        <GridPane hgap="12" vgap="12" style="-fx-padding: 24;">
            <columnConstraints>
                <ColumnConstraints minWidth="150" halignment="RIGHT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="同步主機名稱" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="remoteBaseUrlField" promptText="可選，例如 https://api.example.com" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="JDBC URL" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="jdbcUrlField" promptText="jdbc:postgresql://..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="使用者名稱" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="密碼" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="此為首次安裝，需由管理者填入資訊"
                   style="-fx-text-fill: #b00020; -fx-font-size: 14px; -fx-font-weight: bold;"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Separator GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" />

            <VBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                <Button fx:id="downloadAllButton" text="從雲端更新全部可同步資料" styleClass="btn-blue" onAction="#onDownloadAll" />
                <Label fx:id="syncStatusLabel"
                       text="只下載雲端資料，不會上傳本機資料。字典、地址、系統設定與 audit 表目前尚未支援。"
                       wrapText="true"
                       style="-fx-text-fill: #555555;" />
                <TextArea fx:id="syncProgressArea" editable="false" wrapText="true"
                          prefRowCount="7" promptText="同步進度會顯示在這裡" />
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT" GridPane.rowIndex="7" GridPane.columnIndex="1">
                <Button fx:id="testConnectionButton" text="測試連線" styleClass="btn-blue" onAction="#onTestConnection"/>
                <Button fx:id="saveButton" text="儲存" styleClass="btn-purple" onAction="#onSave"/>
                <Button fx:id="cancelButton" text="取消" styleClass="btn-orange" onAction="#onCancel"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>
