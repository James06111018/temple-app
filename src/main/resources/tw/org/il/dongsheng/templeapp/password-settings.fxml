<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tw.org.il.dongsheng.templeapp.PasswordSettingsController"
      prefWidth="430" prefHeight="320" spacing="18" alignment="CENTER"
      stylesheets="@style.css"
      style="-fx-padding: 28; -fx-background-color: #f5f0e8;">
    <GridPane hgap="14" vgap="18" alignment="CENTER">
        <Label text="原密碼" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-size: 18px;"/>
        <PasswordField fx:id="oldPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefWidth="190"/>
        <Label text="新密碼" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-size: 18px;"/>
        <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       prefWidth="190" onAction="#onChangePassword"/>
    </GridPane>
    <Button fx:id="changePasswordButton" text="變更密碼" styleClass="btn-purple"
            prefWidth="190" prefHeight="44" onAction="#onChangePassword"/>
    <Label text="密碼必須為 4 至 10 個英數字" style="-fx-text-fill: #3333cc; -fx-font-size: 15px;"/>
    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #555555;"/>
    <Button text="取消" styleClass="btn-orange" onAction="#onCancel"/>
</VBox>
