<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="600" prefHeight="520"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tw.org.il.dongsheng.templeapp.MeritCategoryManagementController"
            stylesheets="@style.css"
            style="-fx-background-color: #f0f0f0;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" right="12" bottom="8" left="12" /></padding>
            <Label text="功德箱分類" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="includeDeletedBox" text="顯示已刪除" onAction="#onIncludeDeletedChanged" />
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets right="12" bottom="10" left="12" /></padding>
            <TableView fx:id="categoryTable" styleClass="my-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="codeColumn" text="代號" prefWidth="120" />
                    <TableColumn fx:id="nameColumn" text="分類" prefWidth="330" />
                    <TableColumn fx:id="statusColumn" text="狀態" prefWidth="110" />
                </columns>
            </TableView>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="60" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="代號" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="codeField" maxWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="分類" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding><Insets top="4" right="12" bottom="12" left="12" /></padding>
            <Button text="新增" prefWidth="82" styleClass="btn-purple" onAction="#onNew" />
            <Button fx:id="saveButton" text="儲存" prefWidth="82" styleClass="btn-save-active" onAction="#onSave" />
            <Button fx:id="deleteButton" text="刪除" prefWidth="82" styleClass="btn-pink" onAction="#onDelete" />
            <Button fx:id="restoreButton" text="還原" prefWidth="82" styleClass="btn-purple" onAction="#onRestore" />
        </HBox>
    </bottom>
</BorderPane>
